@model BookStore.ViewModels.HomeViewModel

@section Styles {
    <style>
        .book-card {
            border: 1px solid #ccc;
            border-radius: 8px;
            padding: 15px;
            margin: 10px;
            width: 260px;
            background-color: white;
        }
    </style>
}

<h2 class="text-center mb-4">Welcome to Book Store</h2>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">Add Book</div>
            <div class="card-body">
                <form method="post" action="/Home/AddBook">
                    <div class="mb-2">
                        <input type="text" name="title" class="form-control" placeholder="Book Title" />
                    </div>
                    <div class="mb-2">
                        <input type="number" step="0.01" name="price" class="form-control" placeholder="Price" />
                    </div>
                    <div class="mb-3">
                        <select name="authorId" class="form-select">
                            @foreach (var a in Model.Authors)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add Book</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">Add Author</div>
            <div class="card-body">
                <form method="post" action="/Home/AddAuthor">
                    <div class="mb-2">
                        <input type="text" name="name" class="form-control" placeholder="Author Name" />
                    </div>
                    <div class="mb-3">
                        <input type="text" name="country" class="form-control" placeholder="Country" />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Add Author</button>
                </form>
            </div>
        </div>
    </div>
</div>

<h3 class="mb-3">All Books</h3>

@if (Model.Books.Count == 0)
{
    <div class="alert alert-warning">No books available</div>
}
else
{
    <div class="d-flex flex-wrap justify-content-center">
        @foreach (var b in Model.Books)
        {
            <div class="book-card shadow-sm">
                <h5>@b.Title</h5>
                <p class="mb-1 text-muted">Author: @b.AuthorName</p>
                <p class="fw-bold">Price: Rs. @b.Price</p>

                <form method="post" action="/Home/RemoveBook" onsubmit="return confirmRemove();">
                    <input type="hidden" name="id" value="@b.Id" />
                    <button type="submit" class="btn btn-danger btn-sm w-100">Remove</button>
                </form>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}